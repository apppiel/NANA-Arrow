  entries:
  - key: main.start
    text: "\uC2DC\uC791\uD558\uAE30"
  - key: main.level_sub
    text: "\uB808\uBCA8 {0}"
  - key: main.level_select
    text: "\uB808\uBCA8 \uC120\uD0DD"
  - key: main.raffle
    text: "\uC751\uBAA8 \uCF54\uB4DC \uBCF4\uAE30"
  - key: select.title
    text: "\uB808\uBCA8 \uC120\uD0DD"
  - key: clear.title
    text: "\uD074\uB9AC\uC5B4!"
  - key: clear.level
    text: "\uB808\uBCA8 {0}"
  - key: clear.next
    text: "\uB2E4\uC74C \uB808\uBCA8"
  - key: clear.main
    text: "\uBA54\uC778\uC73C\uB85C"
  - key: clear.all_done
    text: "\uC900\uBE44\uB41C \uB808\uBCA8\uC744 \uBAA8\uB450 \uAE7C\uC5B4\uC694!"
  - key: fail.title
    text: "\uD558\uD2B8\uB97C \uBAA8\uB450 \uC783\uC5C8\uC5B4\uC694"
  - key: fail.continue
    text: "\uAD11\uACE0 \uBCF4\uACE0 \uC774\uC5B4\uD558\uAE30"
  - key: fail.retry
    text: "\uB2E4\uC2DC\uD558\uAE30"
  - key: fail.ad_unavailable
    text: "\uC9C0\uAE08\uC740 \uAD11\uACE0\uB97C \uBD88\uB7EC\uC62C \uC218 \uC5C6\uC5B4\uC694"
  - key: settings.title
    text: "\uC124\uC815"
  - key: settings.sound
    text: "\uC0AC\uC6B4\uB4DC"
  - key: settings.vibration
    text: "\uC9C4\uB3D9"
  - key: confirm_main.body
    text: "\uBA54\uC778\uC73C\uB85C \uAC08\uAE4C\uC694?"
  - key: confirm_main.sub
    text: "\uC9C4\uD589 \uC911\uC778 \uB808\uBCA8\uC740 \uCC98\uC74C\uBD80\uD130
      \uB2E4\uC2DC \uC2DC\uC791\uD574\uC694"
  - key: confirm_main.stay
    text: "\uACC4\uC18D\uD558\uAE30"
  - key: confirm_main.leave
    text: "\uB098\uAC00\uAE30"
  - key: raffle.title
    text: "100\uB2E8\uACC4 \uB2EC\uC131!"
  - key: raffle.body
    text: "\uC544\uB798 \uCF54\uB4DC\uB85C \uACBD\uD488 \uC774\uBCA4\uD2B8\uC5D0
      \uC751\uBAA8\uD560 \uC218 \uC788\uC5B4\uC694"
  - key: raffle.copy
    text: "\uCF54\uB4DC \uBCF5\uC0AC"
  - key: raffle.copied
    text: "\uBCF5\uC0AC\uD588\uC5B4\uC694"
  - key: raffle.go
    text: "\uC0C1\uD488 \uBC1B\uC73C\uB7EC \uAC00\uAE30"
  - key: common.close
    text: "\uB2EB\uAE30"
  - key: quit.body
    text: "\uAC8C\uC784\uC744 \uC885\uB8CC\uD560\uAE4C\uC694?"
  - key: quit.cancel
    text: "\uCDE8\uC18C"
  - key: quit.ok
    text: "\uC885\uB8CC"
  - key: tut.tap
    text: "\uC774\uB3D9\uD558\uB824\uBA74 \uD0ED\uD558\uC138\uC694"
  - key: tut.free_first
    text: "\uC55E\uC774 \uBE44\uC5B4 \uC788\uB294 \uD654\uC0B4\uD45C\uBD80\uD130
      \uB0A0\uB824 \uBCF4\uC138\uC694"
  - key: tut.block
    text: "\uC55E\uC774 \uB9C9\uD600 \uC788\uC73C\uBA74 \uD558\uD2B8\uAC00 \uC904\uC5B4\uC694"
  - key: tut.long_press
    text: "\uD654\uC0B4\uD45C\uB97C \uAE38\uAC8C \uB204\uB974\uBA74 \uAC00\uB294
      \uAE38\uC774 \uBCF4\uC5EC\uC694"
  - key: tut.frozen
    text: "\uC5BC\uC74C \uD654\uC0B4\uD45C\uB294 \uD55C \uBC88 \uD0ED\uD574 \uC5BC\uC74C\uC744
      \uAE68\uACE0, \uB2E4\uC2DC \uD0ED\uD574 \uB0A0\uB824\uC694"
  - key: tut.key
    text: "\uC5F4\uC1E0 \uD654\uC0B4\uD45C\uB97C \uBAA8\uB450 \uB0A0\uB9AC\uBA74
      \uAC19\uC740 \uC0C9 \uC790\uBB3C\uC1E0\uAC00 \uD480\uB824\uC694"
  - key: raffle.status.checking
    text: "\uCF54\uB4DC \uD655\uC778 \uC911\u2026"
  - key: raffle.status.saving
    text: "\uC11C\uBC84\uC5D0 \uC800\uC7A5 \uC911\u2026"
  - key: raffle.status.issued
    text: "\uCF54\uB4DC\uAC00 \uBC1C\uAE09\uB418\uC5C8\uC2B5\uB2C8\uB2E4!"
  - key: raffle.status.reissued
    text: "\uBC1C\uAE09\uB41C \uCF54\uB4DC\uC785\uB2C8\uB2E4"
  - key: raffle.status.offline
    text: "\uC11C\uBC84 \uC5F0\uACB0 \uC2E4\uD328 \u2014 \uCF54\uB4DC\uB97C \uBCF5\uC0AC\uD558\uAC70\uB098
      \uAF2D \uC801\uC5B4\uB450\uC138\uC694"
  - key: raffle.status.save_failed
    text: "\uC11C\uBC84 \uC800\uC7A5 \uC2E4\uD328 \u2014 \uCF54\uB4DC\uB97C \uBCF5\uC0AC\uD558\uAC70\uB098
      \uAF2D \uC801\uC5B4\uB450\uC138\uC694"
